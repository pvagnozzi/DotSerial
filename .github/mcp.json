{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "tools": [
        "resolve-library-id",
        "get-library-docs"
      ]
    },
    "dotnet-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./src"],
      "tools": ["read_file", "list_directory", "search_files"]
    }
  }
}
