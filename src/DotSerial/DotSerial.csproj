<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- iOS SDK is only available on macOS; exclude net10.0-ios on other platforms -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('OSX'))">net10.0;net10.0-android</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- NuGet metadata -->
    <PackageId>DotSerial</PackageId>
    <Authors>Piergiorgio Vagnozzi</Authors>
    <Company>Piergiorgio Vagnozzi</Company>
    <Product>DotSerial</Product>
    <Description>A cross-platform serial port library for .NET supporting classic and stream-based I/O on Windows, Linux, macOS, Android, and iOS.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pvagnozzi/DotSerial</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pvagnozzi/DotSerial</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>serial;serialport;com;uart;cross-platform;dotnet;maui;bluetooth;tcp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Decorators\ThrottledSerialPort.cs" />
    <Compile Remove="Decorators\ThrottledSerialPortLog.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DotSerial.Tests.Unit</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- All platforms: logging -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="GitVersion.MsBuild" Version="6.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Desktop (Windows, Linux, macOS) only -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.IO.Ports" Version="10.0.7" />
  </ItemGroup>

  <!-- Exclude platform-specific files from wrong targets -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="Internal\Windows\DesktopSerialPort.cs" />
    <Compile Remove="Internal\Windows\DesktopSerialPortLog.cs" />
    <Compile Remove="Internal\Windows\DesktopSerialPortMonitor.cs" />
    <Compile Remove="Internal\Windows\DesktopSerialPortMonitorLog.cs" />
    <Compile Remove="Internal\Linux\LinuxSerialPortMonitor.cs" />
    <Compile Remove="Internal\Linux\LinuxSerialPortMonitorLog.cs" />
    <Compile Remove="Internal\MacOS\MacOSSerialPortMonitor.cs" />
    <Compile Remove="Internal\MacOS\MacOSSerialPortMonitorLog.cs" />
    <Compile Remove="Internal\Network\NetworkSerialPort.cs" />
    <Compile Remove="Internal\Network\NetworkSerialPortLog.cs" />
  </ItemGroup>

  <!-- Exclude Android/iOS from net10.0 desktop targets -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Internal\Android\**\*.cs" />
    <Compile Remove="Internal\iOS\**\*.cs" />
  </ItemGroup>

  <!-- Exclude desktop platforms from Android -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <Compile Remove="Internal\Windows\**\*.cs" />
    <Compile Remove="Internal\Linux\**\*.cs" />
    <Compile Remove="Internal\MacOS\**\*.cs" />
    <Compile Remove="Internal\iOS\**\*.cs" />
  </ItemGroup>

  <!-- Exclude desktop platforms from iOS -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <Compile Remove="Internal\Windows\**\*.cs" />
    <Compile Remove="Internal\Linux\**\*.cs" />
    <Compile Remove="Internal\MacOS\**\*.cs" />
    <Compile Remove="Internal\Android\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Decorators\" />
  </ItemGroup>

</Project>
